# =============================================================================
# Lumina 环境变量模板 — 复制为 .env.local 并填入真实值
# =============================================================================

# --- 数据库 (Neon Serverless Postgres) ---
# Neon 连接串，形如 postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# --- 文件存储 (Vercel Blob) ---
# 从 Vercel Dashboard 创建 Blob Store 后获取，读写凭证
BLOB_READ_WRITE_TOKEN=

# --- 认证 (Better-Auth) ---
# 随机长字符串，用于签名会话 JWT，可用 `openssl rand -base64 32` 生成
BETTER_AUTH_SECRET=
# 应用部署地址，本地开发用 http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# --- 实时通讯 (Cloudflare Durable Objects Worker) ---
# 部署 cf-worker 后得到的 Worker URL，形如 https://lumina-realtime.<account>.workers.dev
CF_WORKER_URL=
# Next.js 调用 CF Worker webhook 时携带的共享密钥，需与 cf-worker 的 LUMINA_API_TOKEN 一致
CF_WORKER_AUTH_TOKEN=
